<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="rootPane" onKeyPressed="#handleKeyPressed" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.snakeonthenetwork.ui.GameController">

    <center>
        <Canvas fx:id="gameCanvas" height="600.0" width="800.0" />
    </center>

    <right>
        <VBox spacing="10" style="-fx-padding: 10; -fx-background-color: #ddd;">
         <Label fx:id="gameNameLabel" prefHeight="35.0" prefWidth="144.0">
            <font>
               <Font size="15.0" />
            </font>
         </Label>
            <Label style="-fx-font-weight: bold;" text="Scoreboard" />
            <ListView fx:id="scoreList" prefHeight="400.0" prefWidth="150.0" />
         <Label fx:id="configLabel" prefHeight="52.0" prefWidth="145.0" textAlignment="CENTER">
            <font>
               <Font size="15.0" />
            </font>
         </Label>
            <Button onAction="#handleExit" text="Leave Game" />
        </VBox>
    </right>

</BorderPane>
